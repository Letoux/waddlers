{
  "name": "waddlers",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm --filter @waddlers/web dev",
    "build": "pnpm --filter @waddlers/web build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --project domain --project server --project web",
    "test:e2e": "pnpm --filter @waddlers/web test:e2e",
    "test:integration": "vitest run --project integration",
    "db:migrate": "pnpm --filter @waddlers/server db:migrate",
    "db:generate": "pnpm --filter @waddlers/server db:generate",
    "db:check": "pnpm --filter @waddlers/server db:check",
    "db:setup-roles": "pnpm --filter @waddlers/server db:setup-roles",
    "db:seed": "pnpm --filter @waddlers/worker db:seed",
    "admin": "pnpm --filter @waddlers/worker admin"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
