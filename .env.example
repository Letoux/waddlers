# Copy to .env (never commit .env). Placeholder values only, no real secrets.
# Passwords must be URL-safe (A-Z a-z 0-9 . _ ~ -) because they are embedded in database URLs:
#   openssl rand -hex 24
POSTGRES_USER=waddlers
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=waddlers

# Least privilege (S2): two database roles.
#  - owner (POSTGRES_USER): runs migrations and `pnpm db:setup-roles`. Used ONLY by DATABASE_MIGRATE_URL.
#  - app role (waddlers_app): DML only. Used by the web app, the admin CLI and the seed via DATABASE_URL.
# Create/update the app role, then migrate:  pnpm db:setup-roles && pnpm db:migrate
APP_DB_PASSWORD=change-me-app-role-local-only
DATABASE_URL=postgres://waddlers_app:change-me-app-role-local-only@localhost:5432/waddlers
DATABASE_MIGRATE_URL=postgres://waddlers:change-me-local-only@localhost:5432/waddlers
DATABASE_URL_TEST=postgres://waddlers:waddlers-test@localhost:5433/waddlers_test

APP_ORIGIN=http://localhost:3000
MARKET_DATA_PROVIDER=fake

# HMAC key for device cookies (>= 32 bytes, never commit a real value). REQUIRED: the app refuses to
# start without it. Generate one and append it to your local .env:
#   echo "AUTH_SECRET=$(openssl rand -base64 48)" >> .env
# Changing it only makes existing device cookies invalid (users are throttled as unknown devices).
# AUTH_SECRET=<generated, see above>

# Only set behind a reverse proxy you control that overwrites this header (rate limiting by IP).
# Leave unset otherwise: client-supplied forwarded headers are spoofable.
# TRUSTED_PROXY_HEADER=x-forwarded-for

# Dev seed only (`pnpm db:seed`; refuses NODE_ENV=production). Min 12 characters.
# SEED_USER_USERNAME=dev
# SEED_USER_PASSWORD=change-me-dev-user-password
